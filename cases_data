// Fixed heat grid (row, col, intensity 0-1) — hand-placed hotspot cluster
export const HEAT: HeatCell[] = (() => {
  const rows = 7
  const cols = 10
  const hot = [
    [2, 6], [2, 7], [3, 6], [3, 7], [3, 8], [4, 7],
  ]
  const grid: HeatCell[] = []
  for (let r = 0; r < rows; r++) {
    for (let c = 0; c < cols; c++) {
      const isHot = hot.some(([hr, hc]) => Math.abs(hr - r) <= 1 && Math.abs(hc - c) <= 1)
      const dist = hot.reduce(
        (min, [hr, hc]) => Math.min(min, Math.hypot(hr - r, hc - c)),
        99
      )
      const intensity = Math.max(0, 1 - dist / 3.2)
      grid.push({
        r,
        c,
        v: isHot ? Math.max(intensity, 0.55) : intensity * 0.4,
      })
    }
  }
  return grid
})()

