# Create src/components/TypingDots.tsx
typing_dots = '''import { COLORS } from '@/utils/constants'

/**
 * Animated typing indicator for AI responses
 */
export function TypingDots() {
  return (
    <span className="inline-flex gap-1 items-center">
      {[0, 1, 2].map((i) => (
        <span
          key={i}
          className="animate-ksp-blink"
          style={{
            width: 5,
            height: 5,
            borderRadius: 999,
            background: COLORS.cyan,
            animationDelay: `${i * 0.15}s`,
          }}
        />
      ))}
    </span>
  )
}
'''

with open(f"{base_dir}/src/components/TypingDots.tsx", "w") as f:
    f.write(typing_dots)

