
# Create Vite config with path aliases and build safeguards
vite_config = """import { defineConfig } from 'vite'
import react from '@vitejs/plugin-react'
import path from 'path'

// https://vitejs.dev/config/
export default defineConfig({
  plugins: [react()],
  resolve: {
    alias: {
      '@': path.resolve(__dirname, './src'),
      '@components': path.resolve(__dirname, './src/components'),
      '@pages': path.resolve(__dirname, './src/pages'),
      '@hooks': path.resolve(__dirname, './src/hooks'),
      '@utils': path.resolve(__dirname, './src/utils'),
      '@styles': path.resolve(__dirname, './src/styles'),
      '@assets': path.resolve(__dirname, './src/assets'),
    },
  },
  build: {
    outDir: 'dist',
    sourcemap: true,
    // Ensure all assets are properly handled
    assetsInlineLimit: 4096,
    // Prevent empty chunks
    rollupOptions: {
      output: {
        manualChunks: {
          vendor: ['react', 'react-dom', 'react-router-dom'],
          charts: ['recharts'],
        },
      },
    },
  },
  // Ensure CSS is properly extracted
  css: {
    devSourcemap: true,
  },
  // Preview config for testing production build locally
  preview: {
    port: 4173,
    host: true,
  },
})
"""

with open(f"{base_dir}/vite.config.ts", "w") as f:
    f.write(vite_config)

print("✅ vite.config.ts created with path aliases and build safeguards")
